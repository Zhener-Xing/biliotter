LLM_ENABLED=true
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_MS=20000
LLM_NOTES_TIMEOUT_MS=60000
# 一键整理输出上限（越小越快；二次整理还会只送字幕增量）
LLM_NOTES_MAX_TOKENS=1600

# Cloud sync (desktop → your cloud-api). Leave empty to run local-only.
# Example: https://pet-api.example.com
CLOUD_API_BASE=
