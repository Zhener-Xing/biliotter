PORT=8787
# 0.0.0.0 = 允许公网 IP 访问；若前面有 Nginx，可改为 127.0.0.1
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_SEC=604800
# Must match desktop CLOUD_DEVICE_SECRET (test build default)
DEVICE_AUTH_SECRET=0703251607192333333

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bili_pet
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=bili_pet

# —— LLM 后方代理（桌宠走代理；key 只放服务器，勿写进桌宠分发包）——
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_MS=60000
LLM_PROXY_MAX_TOKENS=4096
